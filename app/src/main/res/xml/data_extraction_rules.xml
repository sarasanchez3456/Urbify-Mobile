<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- El DataStore de sesión guarda el token JWT. Se excluye tanto de la
         copia en la nube como de la transferencia directa entre
         dispositivos para que la sesión no viaje fuera del dispositivo
         original. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/urbify_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/urbify_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>