# Copia este archivo como "keystore.properties" en la raíz del proyecto y
# completa los valores reales. "keystore.properties" está en .gitignore:
# NUNCA debe subirse al repositorio.
#
# Ver docs/RELEASE_SIGNING.md para cómo generar el keystore y para la
# alternativa de CI (variables de entorno).

storeFile=/ruta/absoluta/o/relativa/al/keystore-release.jks
storePassword=CAMBIAR_ESTA_PASSWORD
keyAlias=urbify-release
keyPassword=CAMBIAR_ESTA_PASSWORD
